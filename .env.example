# Token del bot de Telegram (te lo da @BotFather cuando creas el bot)
TELEGRAM_BOT_TOKEN=

# Tu ID numerico de Telegram (te lo da @userinfobot). El bot SOLO responde a este ID y a los de abajo.
OWNER_TELEGRAM_ID=

# Opcional: IDs de otras personas autorizadas a usar el bot, separados por coma.
# Ej: OTROS_TELEGRAM_IDS=111111111,222222222
OTROS_TELEGRAM_IDS=

# Tu API key de Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Modelo de Claude a usar para el "cerebro"
CLAUDE_MODEL=claude-sonnet-5

# Puerto donde corre el panel web (se accede por http://localhost:PUERTO o http://IP-de-tu-PC:PUERTO)
PANEL_PORT=4000

# Clave para entrar al panel web (usuario puede ser cualquiera, la clave es esta)
PANEL_PASSWORD=

# Token del bot de Telegram (te lo da @BotFather cuando creas el bot)
TELEGRAM_BOT_TOKEN=

# Tu ID numerico de Telegram (te lo da @userinfobot). El bot SOLO responde a este ID y a los de abajo.
OWNER_TELEGRAM_ID=

# Opcional: IDs de otras personas autorizadas a usar el bot, separados por coma.
# Ej: OTROS_TELEGRAM_IDS=111111111,222222222
OTROS_TELEGRAM_IDS=

# Tu API key de Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Modelo de Claude a usar para el "cerebro"
CLAUDE_MODEL=claude-sonnet-5

# Puerto donde corre el panel web (se accede por http://localhost:PUERTO o http://IP-de-tu-PC:PUERTO)
PANEL_PORT=4000

# Clave para entrar al panel web (usuario puede ser cualquiera, la clave es esta)
PANEL_PASSWORD=

# Base de datos en Turso (turso.tech): la URL y el token te los da su panel al crear la base.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional pero recomendado: una clave inventada por vos para validar que los mensajes al
# webhook de Telegram vengan realmente de Telegram (se usa solo cuando el bot corre en Vercel).
TELEGRAM_WEBHOOK_SECRET=

# Opcional: para "npm run test-bot" (probar el bot por Telegram de verdad, sin arriesgar el
# webhook real ni ensuciar los datos reales). Un bot y una base de Turso aparte, solo de prueba.
TELEGRAM_BOT_TOKEN_TEST=
TURSO_DATABASE_URL_TEST=
TURSO_AUTH_TOKEN_TEST=

# Para el chequeo automatico del webhook (.github/workflows/verificar-webhook.yml), que cada 30
# min se fija que el webhook siga bien puesto y lo repone solo si se cae:
# - TELEGRAM_WEBHOOK_URL_ESPERADA: la URL que el webhook DEBERIA tener (la de produccion).
# - CRON_SECRET: clave inventada por vos para que solo el chequeo automatico pueda llamar a ese
#   endpoint. Tiene que ser la MISMA que el secret CRON_SECRET del repo en GitHub (Settings ->
#   Secrets and variables -> Actions).
TELEGRAM_WEBHOOK_URL_ESPERADA=https://gestor-mayorista-lucas.vercel.app/api/telegram-webhook
CRON_SECRET=
